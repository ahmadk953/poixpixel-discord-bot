{
  "name": "poixpixel-discord-bot",
  "version": "1.0.0",
  "main": "./src/discord-bot.ts",
  "author": "Poixpixel",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "yarn clean && tsc && tsc-alias",
    "dev": "tsx watch --include \"src/*/**\" src/discord-bot.ts",
    "start": "pm2 start ./target/discord-bot.js --name poixpixel-discord-bot",
    "restart": "pm2 restart poixpixel-discord-bot",
    "undeploy-commands": "tsx src/util/undeployCommands.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf ./target",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "setup": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "logform": "^2.7.0",
    "pg": "^8.22.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "ultracite": "7.8.4"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
