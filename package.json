{
  "name": "poixpixel-discord-bot",
  "version": "1.0.0",
  "main": "./src/discord-bot.ts",
  "author": "Poixpixel",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "yarn clean && tsc && tsc-alias",
    "dev": "tsx watch --include \"src/*/**\" src/discord-bot.ts",
    "start": "pm2 start ./target/discord-bot.js --name poixpixel-discord-bot",
    "restart": "pm2 restart poixpixel-discord-bot",
    "undeploy-commands": "tsx src/util/undeployCommands.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf ./target",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "setup": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "discord.js": "^14.25.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.10.0",
    "logform": "^2.7.0",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.4",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ultracite": "7.3.1"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
