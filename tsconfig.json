{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext"],

    "module": "nodenext",
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "paths": {
      "@/*": ["./src/*", "./"]
    },
    "resolveJsonModule": true,

    "outDir": "./target",

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
